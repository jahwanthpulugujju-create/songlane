<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your next favorite is waiting" android:textColor="#F0F2E8" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Songlane" android:textColor="#CAEF91" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_previous" android:tint="#CAEF91" android:contentDescription="Previous song" />
    <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:tint="#CAEF91" android:contentDescription="Play" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_next" android:tint="#CAEF91" android:contentDescription="Next song" />
</LinearLayout>
